# Copy to .env and adjust. Never commit the real .env.

# --- Database / queue ---
POSTGRES_USER=agentops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=agentops
DATABASE_URL=postgresql+psycopg://agentops:change-me-local-only@postgres:5432/agentops
REDIS_URL=redis://redis:6379/0

# --- Telemetry sources ---
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
DEMO_SERVICE_URL=http://demo-service:8001

# --- Kubernetes (demo namespace only) ---
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=agentops-demo
KUBERNETES_DEPLOYMENT=demo-service
KUBECONFIG_PATH=

# --- LLM (optional; deterministic fallback is used when LLM_API_KEY is empty) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# --- Safety ---
MAX_REPLICAS=5
MIN_REPLICAS=1
REQUIRE_APPROVAL_FOR_RISK=medium,high
EXTERNAL_CALL_TIMEOUT_SECONDS=5
EXTERNAL_CALL_MAX_RETRIES=2

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
